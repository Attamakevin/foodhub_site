# Paystack secret key (use sk_test_... while testing, sk_live_... when you go live)
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SECRET_KEY
# Password for the staff admin page (#/admin)
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# Your live website address, no trailing slash
SITE_URL=https://www.yourdomain.com
# BLOB_STORE_ID is added automatically when you connect a Public Blob store in Vercel
# Optional: email yourself every paid order (free account at resend.com)
RESEND_API_KEY=
OWNER_EMAIL=
MAIL_FROM=
